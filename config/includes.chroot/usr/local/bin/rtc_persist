#!/bin/sh

DEVICE=$(findfs LABEL=persistence | sed 's/\/dev\///')
FS_OVERLAY="/lib/live/mount/persistence/$DEVICE/fs_overlay"

PersistLoad() {
	echo "try to load fs_overlay from persistence partition..."
    if [ -d "${FS_OVERLAY}" ] ; then
        echo "${FS_OVERLAY} found..."
        cp -r $FS_OVERLAY/* /
    fi
}

PersistLoad
